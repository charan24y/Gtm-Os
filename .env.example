# =============================================================================
# GTM OS — ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# 1. Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Google OAuth (Configured in Google Cloud Console & Supabase Dashboard)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 3. TinyFish Web Intelligence (Live Search, Fetch, Agent, Browser)
TINYFISH_API_KEY=sk-tinyfish-yvcGRabmg0NXiv37oouDpr2b0YpcavTq

# 4. Grok (xAI API — Product Analysis, ICP, Qualification, Outreach, Reply Intent)
XAI_API_KEY=your_xai_grok_key

# 5. Contact Enrichment Providers
APOLLO_API_KEY=your_apollo_key
HUNTER_API_KEY=your_hunter_key

# 6. Email Outreach & Webhook Events (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret
RESEND_FROM_EMAIL=GTM OS <onboarding@resend.dev>

# 7. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
